<Window x:Class="Toolbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Toolbox · 插件化工具箱"
        Height="900"
        Width="1440"
        MinHeight="640"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="Assets/app.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing"
        Loaded="OnWindowLoaded"
        StateChanged="OnWindowStateChanged"
        DataContextChanged="OnDataContextChanged">

    <!--
        ════════════════════════════════════════════════════════════════════
        无边框窗口 + 自定义标题栏（WindowChrome）
          * CaptionHeight=56 与顶部栏等高：顶部栏空白区 = 可拖拽/双击最大化的标题区；
            交互控件（头像/搜索/窗口按钮）标 IsHitTestVisibleInChrome 才能收到点击。
          * 最大化时给 RootGrid 7px 内缩（State 处理），避免不可见边框顶出屏幕/压任务栏。
        ════════════════════════════════════════════════════════════════════
        布局（本版）：
        ┌──────────────────────────────────────────────────────────────────┐
        │ (头像) Toolbox … · v1.0.0-beta  [搜索 Ctrl+K]      ─ □ ✕         │ ← 自定义标题栏
        ├─────────────┬──────────────┬───────────────────┬─────────────────┤
        │ 图文工具栏   │ 插件列表/详情│ 插件界面/日志(切换)│ 结果历史        │
        │ 可折叠文本    │ 右键=单插件  │ ← TabControl      │      右侧        │
        │ 底部:关于/设置│              │                   │                 │
        ├─────────────┴──────────────┴───────────────────┴─────────────────┤
        │ 状态栏：已加载插件：N / M · 视图标签页：K · <最近操作>            │
        └──────────────────────────────────────────────────────────────────┘

        ⚠ 卸载验证优先，三条不能动的约束：
          1. 插件视图必须仍然挂在 TabControl 上（日志视图只是 Collapsed，不移出逻辑/视觉树）；
          2. 任何宿主侧控件都不允许持有插件对象 —— 这里只绑定 PluginDescriptor 的字符串投影；
          3. **不给插件视图（或它的容器）挂动画**：动画计时器会持有目标元素，
             等于把插件对象钉在计时器上，卸载回收验证必然失败。动画只做宿主自己的外观。
    -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide" Y="12" />
        </Grid.RenderTransform>

        <!-- 窗口入场：整体淡入 + 轻微上移 -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.38">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RootSlide" Storyboard.TargetProperty="Y"
                                         To="0" Duration="0:0:0.38">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════ 顶部栏 = 自定义标题栏（56px）：头像 + 标题 + 搜索 + 窗口按钮 ═══════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,6,4,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 用户头像（左上角）：属于标题栏区域，必须标记为 chrome 可交互 -->
                <ToggleButton x:Name="AvatarToggle"
                              Grid.Column="0"
                              Style="{StaticResource AvatarToggle}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              AutomationProperties.Name="用户头像"
                              ToolTip="{Binding UserTooltip}" />

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Toolbox 插件化工具箱"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding HeaderSubtitle}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <!-- 命令面板入口（Ctrl+K） -->
                <Button Grid.Column="2"
                        Style="{StaticResource SearchPill}"
                        Command="{Binding TogglePaletteCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="搜索（Ctrl K）"
                        ToolTip="命令面板：搜索插件、执行命令（Ctrl+K）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="搜索插件与命令"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Background="{DynamicResource NeutralSoftBrush}"
                                CornerRadius="6"
                                Padding="6,1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="Ctrl K" FontSize="10.5" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- 自定义窗口按钮：最小化 / 最大化(还原) / 关闭（关闭 = 最小化到托盘） -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}"
                            Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}"
                            Click="OnMaximizeClick"
                            AutomationProperties.Name="最大化或还原"
                            ToolTip="最大化 / 还原">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}"
                            Click="OnCaptionCloseClick"
                            AutomationProperties.Name="关闭"
                            ToolTip="关闭（最小化到托盘，托盘菜单可退出）">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 头像点击后的用户信息卡（纯字符串，不持有任何插件对象） -->
        <Popup IsOpen="{Binding IsChecked, ElementName=AvatarToggle}"
               PlacementTarget="{Binding ElementName=AvatarToggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{StaticResource FlyoutCard}" Margin="0,6,0,0" Padding="14,12" MinWidth="270">
                <StackPanel>
                    <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding UserAccountLine}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                    <Separator Margin="0,10,0,10" Background="{DynamicResource BorderSoftBrush}" />
                    <TextBlock Text="{Binding UserRuntimeLine}" Style="{StaticResource HintText}" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═══════════ 主体：图文工具栏 / 插件列表 / 界面·日志 / 结果历史 ═══════════ -->
        <!-- 正文区包一层 ScrollViewer：字号缩放（125%/150%）后内容超出窗口时可以滚动，不裁切 -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0">
            <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="360" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ─── 最左：图文工具栏（默认带文字，可折叠）─── -->
            <Border x:Name="RailCard"
                    Grid.Column="0"
                    Width="168"
                    Style="{StaticResource Card}"
                    Padding="6,8"
                    Margin="0,0,0,0">
                <DockPanel LastChildFill="True">
                    <!-- 顶部：折叠开关 + 主功能 -->
                    <StackPanel DockPanel.Dock="Top">
                        <!-- 折叠/展开文字 -->
                        <ToggleButton x:Name="RailToggle"
                                      Style="{StaticResource WideRailToggle}"
                                      IsChecked="{Binding IsRailExpanded, Mode=TwoWay}"
                                      AutomationProperties.Name="收起侧栏"
                                      ToolTip="收起 / 展开侧栏文字">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RailCollapseGlyph" Text="&#xE76B;" Style="{StaticResource RailIcon}" />
                            </StackPanel>
                        </ToggleButton>

                        <Separator Margin="6,4,6,8" Background="{DynamicResource BorderSoftBrush}" />

                        <!-- 日志（独立功能，默认隐藏，点击切换中间面板） -->
                        <ToggleButton Style="{StaticResource WideRailToggle}"
                                      IsChecked="{Binding IsLogView, Mode=TwoWay}"
                                      AutomationProperties.Name="日志"
                                      ToolTip="实时日志（与插件界面互斥显示）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource RailIcon}" />
                                <TextBlock Text="日志" Style="{StaticResource RailLabel}" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- 添加工具：展开浮层选择插件包/文件夹 -->
                        <ToggleButton x:Name="AddToolToggle"
                                      Style="{StaticResource WideRailToggle}"
                                      IsChecked="{Binding IsAddToolOpen, Mode=TwoWay}"
                                      AutomationProperties.Name="添加工具"
                                      ToolTip="添加工具：安装插件包（zip / dll / 文件夹）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource RailIcon}" />
                                <TextBlock Text="添加工具" Style="{StaticResource RailLabel}" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- 插件市场 -->
                        <Button Style="{StaticResource WideRailButton}"
                                Command="{Binding OpenMarketCommand}"
                                AutomationProperties.Name="插件市场"
                                ToolTip="插件市场：浏览并安装插件包">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource RailIcon}" />
                                <TextBlock Text="插件市场" Style="{StaticResource RailLabel}" />
                            </StackPanel>
                        </Button>

                        <!-- 打开插件目录 -->
                        <Button Style="{StaticResource WideRailButton}"
                                Command="{Binding OpenPluginFolderCommand}"
                                AutomationProperties.Name="打开插件目录"
                                ToolTip="在资源管理器中打开插件目录">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource RailIcon}" />
                                <TextBlock Text="打开插件目录" Style="{StaticResource RailLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 底部：关于 + 设置（左下角），设置在最底 -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="6,8,6,6" Background="{DynamicResource BorderSoftBrush}" />

                        <Button Style="{StaticResource WideRailButton}"
                                Command="{Binding AboutCommand}"
                                AutomationProperties.Name="关于"
                                ToolTip="关于：版本 / 运行时 / 说明">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource RailIcon}" />
                                <TextBlock Text="关于" Style="{StaticResource RailLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource WideRailButton}"
                                Command="{Binding OpenSettingsCommand}"
                                AutomationProperties.Name="设置"
                                ToolTip="设置（宿主配置 · 主题切换 · 重新扫描/重新加载）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource RailIcon}" />
                                <TextBlock Text="设置" Style="{StaticResource RailLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 中部占位 -->
                    <Border />
                </DockPanel>
            </Border>

            <!-- 添加工具的浮层：两条入口（插件包 / 插件文件夹） -->
            <Popup IsOpen="{Binding IsChecked, ElementName=AddToolToggle}"
                   PlacementTarget="{Binding ElementName=AddToolToggle}"
                   Placement="Right"
                   HorizontalOffset="6"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Style="{StaticResource FlyoutCard}" MinWidth="270">
                    <StackPanel>
                        <TextBlock Text="添加工具" FontWeight="SemiBold" FontSize="12" Margin="10,6,10,6" />

                        <Button Style="{StaticResource FlyoutOption}"
                                Command="{Binding AddPackageCommand}"
                                AutomationProperties.Name="选择插件包">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F4;" Style="{StaticResource RailIcon}"
                                           FontSize="16" Margin="0,0,10,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <StackPanel>
                                    <TextBlock Text="选择插件包（.zip / .dll）" FontSize="12" />
                                    <TextBlock Text="安装到插件目录并立即加载" Style="{StaticResource HintText}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource FlyoutOption}"
                                Command="{Binding AddFolderCommand}"
                                AutomationProperties.Name="选择插件文件夹">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource RailIcon}"
                                           FontSize="16" Margin="0,0,10,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <StackPanel>
                                    <TextBlock Text="选择插件文件夹" FontSize="12" />
                                    <TextBlock Text="目录插件：整个文件夹装进插件目录" Style="{StaticResource HintText}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ─── 中左：插件列表（带过滤框）+ 选中插件详情（右键 = 单插件操作）─── -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="插件" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Plugins.Count, StringFormat={}{0} 个}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            <!-- 过滤框：按显示名 / Id 实时过滤下面的插件行 -->
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding PluginFilter, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="过滤插件"
                                     ToolTip="输入以过滤插件（按名称 / Id）"
                                     Margin="0,8,0,0"
                                     Padding="10,5" />
                        </StackPanel>
                    </Border>

                    <!-- 详情区（停靠在底部）：仍只显示字符串投影 -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="0,1,0,0"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="选中插件详情" Style="{StaticResource SectionTitle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPlugin.Id}" Style="{StaticResource MonoText}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="版本" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPlugin.Version}" Style="{StaticResource FieldValue}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="来源" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPlugin.SourceKind}" Style="{StaticResource FieldValue}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="工具" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPlugin.ToolsText}" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="ALC 程序集" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPlugin.AssemblyCountText}" Style="{StaticResource FieldValue}" />
                            </Grid>

                            <TextBlock Text="错误 / 说明" Style="{StaticResource SectionTitle}" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding SelectedPlugin.Error}"
                                       Style="{StaticResource HintText}"
                                       MaxHeight="60" />
                        </StackPanel>
                    </Border>

                    <!-- 插件行：UIA 名称固定为插件 Id；单击即打开（绑定的是按过滤词筛选后的可见集合） -->
                    <ListBox ItemsSource="{Binding VisiblePlugins}"
                             SelectedItem="{Binding SelectedPlugin}"
                             ItemContainerStyle="{StaticResource PluginListItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6"
                             PreviewMouseRightButtonUp="OnPluginListPreviewMouseRightButtonUp"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu Style="{StaticResource PluginContextMenu}"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Style="{StaticResource PluginMenuItem}"
                                          IsEnabled="False"
                                          FontWeight="SemiBold"
                                          Header="{Binding SelectedPlugin.DisplayName}" />
                                <Separator Style="{StaticResource MenuSeparator}" />
                                <MenuItem Style="{StaticResource PluginMenuItem}"
                                          Header="打开（加载并显示界面）"
                                          Command="{Binding OpenPluginCommand}"
                                          CommandParameter="{Binding SelectedPlugin}" />
                                <MenuItem Style="{StaticResource PluginMenuItem}"
                                          Header="卸载（验证 ALC 回收）"
                                          Command="{Binding UnloadPluginCommand}"
                                          CommandParameter="{Binding SelectedPlugin}" />
                                <MenuItem Style="{StaticResource PluginMenuItem}"
                                          Header="重载（新 ALC）"
                                          Command="{Binding ReloadPluginCommand}"
                                          CommandParameter="{Binding SelectedPlugin}" />
                                <Separator Style="{StaticResource MenuSeparator}" />
                                <MenuItem Style="{StaticResource PluginMenuItem}"
                                          Header="删除插件…（从磁盘移除）"
                                          Command="{Binding DeletePluginCommand}"
                                          CommandParameter="{Binding SelectedPlugin}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource MonoText}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Style="{StaticResource StatusPill}" Padding="7,2">
                                        <TextBlock x:Name="StateText"
                                                   Text="{Binding StateText}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding StateTone}" Value="ok">
                                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateTone}" Value="error">
                                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateTone}" Value="busy">
                                        <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ─── 中：插件界面 / 日志（由最左「日志」按钮切换）─── -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0">
                <Grid>
                    <!-- 插件界面（默认显示） -->
                    <DockPanel x:Name="PluginPane">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceMutedBrush}" Padding="12,10">
                            <Grid>
                                <TextBlock Text="插件界面" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="由插件自己用代码构建，跨 AssemblyLoadContext 挂载"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintText}" />
                            </Grid>
                        </Border>

                        <Grid>
                            <!-- 没有带界面的工具时的占位提示 -->
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ToolTabs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="当前没有带界面的工具。" />
                                <LineBreak />
                                <Run Text="单击左侧插件即可打开；也可点「添加工具」或「插件市场」装上插件包。" />
                            </TextBlock>

                            <TabControl ItemsSource="{Binding ToolTabs}"
                                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                        Style="{StaticResource ToolTabControl}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding ViewHost}" />
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </Grid>
                    </DockPanel>

                    <!-- 日志（独立视图；只切换 Visibility，控件始终留在树上） -->
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogView}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceMutedBrush}" Padding="12,10">
                            <Grid>
                                <TextBlock Text="日志（插件日志带 [pluginId] 前缀）" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="实时 · 同时落盘 logs/"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintText}" />
                            </Grid>
                        </Border>

                        <ListBox ItemsSource="{Binding Logs}"
                                 ItemContainerStyle="{StaticResource LogListItem}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="11"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8,8,8,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="日志">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ─── 右：结果历史（可复制 / 可导出）─── -->
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="10,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceMutedBrush}" Padding="12,10">
                        <Grid>
                            <TextBlock Text="工具输出" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="执行结果留档"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource HintText}" />
                        </Grid>
                    </Border>

                    <Border Padding="12,10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <TextBlock Text="结果历史" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="复制全部"
                                            Style="{StaticResource SubtleButton}"
                                            Padding="9,3"
                                            FontSize="11"
                                            Command="{Binding CopyResultCommand}"
                                            AutomationProperties.Name="复制全部结果" />
                                    <Button Content="导出…"
                                            Style="{StaticResource SubtleButton}"
                                            Padding="9,3"
                                            FontSize="11"
                                            Margin="6,0,0,0"
                                            Command="{Binding ExportHistoryCommand}"
                                            AutomationProperties.Name="导出结果历史" />
                                    <Button Content="清空"
                                            Style="{StaticResource SubtleButton}"
                                            Padding="9,3"
                                            FontSize="11"
                                            Margin="6,0,0,0"
                                            Command="{Binding ClearResultCommand}"
                                            AutomationProperties.Name="清空结果历史" />
                                </StackPanel>
                            </Grid>

                            <!-- 空态提示 -->
                            <TextBlock Text="还没有执行结果：打开插件、运行工具或增删插件后，这里会留档。"
                                       Margin="2,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox ItemsSource="{Binding ResultHistory}"
                                     ItemContainerStyle="{StaticResource HistoryListItem}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Margin="0,4,0,0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="结果历史">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Mark"
                                                               Text="✔"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SuccessBrush}" />
                                                    <TextBlock Text="{Binding Headline}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}"
                                                           Style="{StaticResource HintText}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="复制"
                                                    Style="{StaticResource SubtleButton}"
                                                    Padding="8,3"
                                                    FontSize="11"
                                                    VerticalAlignment="Top"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.CopyResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding CopyLabel}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                <Setter TargetName="Mark" Property="Text" Value="✘" />
                                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════ 状态栏 ═══════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7"
                Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusLine}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding EnvironmentBadge}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource HintText}" />
            </Grid>
        </Border>

        <!-- ═══════════ Ctrl+K 命令面板（顶层覆盖）═══════════ -->
        <Grid x:Name="PaletteLayer"
              Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="200"
              Background="Transparent"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPaletteOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- 点击空白处关闭 -->
            <Border x:Name="PaletteDim"
                    Background="#0A0E16"
                    Opacity="0"
                    MouseLeftButtonDown="OnPaletteOverlayClick" />

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,110,0,0"
                    MinWidth="520"
                    MaxWidth="640"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PaletteScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PaletteSlide" Y="0" />
                    </TransformGroup>
                </Border.RenderTransform>

                <Border x:Name="PaletteCard" Padding="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource FlyoutCard}">
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Padding="14,12"
                                BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE721;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBox x:Name="PaletteSearchBox"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="命令搜索"
                                         ToolTip="输入以过滤插件、命令与工具" />
                                <TextBlock Grid.Column="2"
                                           Text="Esc 关闭"
                                           Style="{StaticResource HintText}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ListBox x:Name="PaletteList"
                                 ItemsSource="{Binding PaletteItems}"
                                 SelectedItem="{Binding SelectedPaletteItem}"
                                 ItemContainerStyle="{StaticResource PaletteListItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8"
                                 MaxHeight="420"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="命令列表" />

                        <Border Padding="14,8"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="↑ ↓ 选择 · Enter 执行 · Ctrl+K 开关 · 单击插件即可直接打开"
                                       Style="{StaticResource HintText}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
