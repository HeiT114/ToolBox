<Window x:Class="Toolbox.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 · Toolbox"
        Width="480"
        Height="500"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- 关于窗口：版本 / 运行时 / 架构 / 说明，全部是静态字符串，不引用任何插件对象。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="34" Height="34"
                        CornerRadius="9"
                        Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="版本 · 运行时 · 说明" Style="{StaticResource HintText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- 应用标识 -->
                <Border Style="{StaticResource Card}" Padding="18,20" Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/app.ico"
                               Width="72" Height="72"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Toolbox 插件化工具箱"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding VersionText}"
                                   Style="{StaticResource MonoText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="插件基于 AssemblyLoadContext 隔离 · 协作式卸载并强制 GC 验证回收"
                                   Style="{StaticResource HintText}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 运行信息 -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="运行信息" Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="运行时" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RuntimeText}" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="操作系统" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OsText}" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="进程架构" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ArchText}" Style="{StaticResource FieldValue}" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="UI 框架" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="WPF（.NET 10 · C# 14）" Style="{StaticResource FieldValue}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 版权 -->
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="版权" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Copyright © Toolbox 2026" Style="{StaticResource HintText}" />
                        <TextBlock Text="本程序为插件宿主：插件是完全信任代码，卸载为协作式弱保证（详见 docs/DESIGN.md）。"
                                   Style="{StaticResource HintText}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Button Content="关闭"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Style="{StaticResource PrimaryButton}" />
        </Border>
    </Grid>
</Window>
