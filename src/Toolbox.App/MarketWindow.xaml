<Window x:Class="Toolbox.App.MarketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插件市场 · Toolbox"
        Width="780"
        Height="560"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        插件市场：浏览 {应用目录}/market/ 里的插件包 → 安装进 plugins/ → 立即加载。
        纯本地目录（无网络依赖）；空市场时自动从已安装的目录插件播种一个 zip。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="34" Height="34"
                        CornerRadius="9"
                        Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE7F8;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="插件市场" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <!-- 「敬请期待」徽标：市场还在内测打磨中，入口保留、能力受控 -->
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="8"
                                Padding="7,2"
                                Margin="9,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="敬请期待"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="本地 market/ 目录 · 安装即加载（内测）" Style="{StaticResource HintText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具条 -->
        <Border Grid.Row="1"
                Padding="16,10"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="刷新市场"
                            Style="{StaticResource SubtleButton}"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="刷新市场" />
                    <Button Content="打开市场目录"
                            Style="{StaticResource SubtleButton}"
                            Margin="8,0,0,0"
                            Command="{Binding OpenMarketFolderCommand}"
                            AutomationProperties.Name="打开市场目录" />
                    <Button Content="从文件安装…"
                            Style="{StaticResource SubtleButton}"
                            Margin="8,0,0,0"
                            Command="{Binding InstallFromFileCommand}"
                            AutomationProperties.Name="从文件安装" />
                </StackPanel>

                <TextBlock Text="{Binding MarketDirectory}"
                           Style="{StaticResource MonoText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           MaxWidth="330"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding MarketDirectory}" />
            </Grid>
        </Border>

        <!-- 市场列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- 空态 -->
                <TextBlock Text="市场里还没有插件：把 .zip 插件包放进 market/ 目录，或点「从文件安装」。"
                           Margin="2,8,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}"
                                    Padding="14,12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13" />
                                            <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0" Padding="7,2">
                                                <TextBlock Text="{Binding VersionText}" FontSize="10.5" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding MetaLine}"
                                                   Style="{StaticResource MonoText}"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource HintText}"
                                                   Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding SourceDisplay}"
                                                   Style="{StaticResource HintText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0">
                                        <Border Style="{StaticResource StatusPill}"
                                                HorizontalAlignment="Center"
                                                Padding="9,3">
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="可安装" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Text" Value="已安装" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <Button Content="{Binding InstallLabel}"
                                                Padding="18,7"
                                                Margin="0,8,0,0"
                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 状态行 -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <TextBlock Text="{Binding Status}"
                           Style="{StaticResource HintText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Content="关闭"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Border>
    </Grid>
</Window>
