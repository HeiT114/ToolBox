<Window x:Class="Toolbox.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toolbox 启动中"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="420"
        Height="280"
        WindowStartupLocation="CenterScreen">

    <!--
        启动画面：深色圆角卡片 + 应用图标 + 版本 + 进度条动画。
        动画只作用在启动画面自身（宿主元素），与插件视图无关。
    -->
    <Border CornerRadius="16"
            Background="#12171F"
            BorderBrush="#2E3849"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Grid.Row="0"
                   Source="pack://application:,,,/Assets/app.ico"
                   Width="96"
                   Height="96"
                   Margin="0,36,0,8"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <TextBlock Grid.Row="1"
                       Text="Toolbox 插件化工具箱"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#E8ECF5"
                       HorizontalAlignment="Center" />

            <TextBlock Grid.Row="2"
                       x:Name="SplashHint"
                       Text="v1.0.0-beta · 正在加载插件…"
                       FontSize="11.5"
                       Foreground="#8A96AC"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />

            <!-- 进度条：轨道 + 循环滑动的光条 -->
            <Grid Grid.Row="3" Width="240" Height="5" Margin="0,22,0,0" VerticalAlignment="Center">
                <Border CornerRadius="3" Background="#262F3E" />
                <Border CornerRadius="3" ClipToBounds="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SlideBar" X="-130" />
                    </Border.RenderTransform>
                    <Border Width="110" Height="5" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#4F46E5" Offset="0" />
                                <GradientStop Color="#22D3EE" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </Grid>

            <!-- 循环滑动动画 -->
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SlideBar"
                                             Storyboard.TargetProperty="X"
                                             From="-130" To="250"
                                             Duration="0:0:1.1"
                                             RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>
    </Border>
</Window>
